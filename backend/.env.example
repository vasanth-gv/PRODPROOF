# =========================================================
# PRODPROOF — Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit a real .env file with credentials to source control.
# =========================================================

# ---- Application ----
APP_NAME=PRODPROOF
APP_ENV=development          # development | staging | production
DEMO_MODE=true                # MUST be explicitly true to enable demo/mock data.
                               # In production this MUST be false.
LOG_LEVEL=INFO

# ---- Database (MySQL) ----
DATABASE_URL=mysql+pymysql://prodproof:prodproof@localhost:3306/prodproof

# ---- Jenkins Integration ----
JENKINS_ENABLED=false
JENKINS_BASE_URL=
JENKINS_USER=
JENKINS_API_TOKEN=
JENKINS_TIMEOUT_SECONDS=8

# ---- Security Scanners ----
TRIVY_ENABLED=false
TRIVY_REPORT_SOURCE=          # e.g. path, S3 URL, or API endpoint the scanner reports land in
GITLEAKS_ENABLED=false
GITLEAKS_REPORT_SOURCE=

# ---- Terraform / Infra ----
TERRAFORM_ENABLED=false
TERRAFORM_PLAN_SOURCE=        # local path or remote backend where plan JSON is read from

# ---- Kubernetes ----
KUBERNETES_ENABLED=false
KUBE_CONFIG_PATH=
KUBE_CONTEXT=
KUBE_NAMESPACE=default

# ---- AWS / Cloud Production Context ----
AWS_ENABLED=false
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Production Database Target (the DB the RELEASE talks to, not PRODPROOF's own DB) ----
PROD_DB_MONITOR_ENABLED=false
PROD_DB_CONNECTION_STRING=
PROD_DB_MAX_CONNECTIONS=

# ---- Integration timeouts (seconds) ----
DEFAULT_INTEGRATION_TIMEOUT_SECONDS=8

# ---- Security ----
SECRET_KEY=change-me-to-a-random-64-char-string
